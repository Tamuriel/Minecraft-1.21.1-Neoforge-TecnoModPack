vec3 _veil_rgb2hsv(vec3 c) {
vec4 K = vec4(0.0f, (-1.0f / 3.0f), (2.0f / 3.0f), -1.0f);
vec4 p = c.g < c.b ? vec4(c.bg, K.wz) : vec4(c.gb, K.xy);
vec4 q = c.r < p.x ? vec4(p.xyw, c.r) : vec4(c.r, p.yzx);
float d = (q.x - min(q.w, q.y));
float e = 1.0E-10f;
return vec3(abs((q.z + ((q.w - q.y) / ((6.0f * d) + e)))), (d / (q.x + e)), q.x);
}
vec3 _veil_hsv2rgb(vec3 c) {
vec4 K = vec4(1.0f, (2.0f / 3.0f), (1.0f / 3.0f), 3.0f);
vec3 p = abs(((fract((c.xxx + K.xyz)) * 6.0f) - K.www));
return (c.z * mix(K.xxx, clamp((p - K.xxx), 0.0f, 1.0f), c.y));
}
vec4 _veil_linear_fog(vec4 inColor, float _veil_vertexDistance, float fogStart, float fogEnd, vec4 fogColor) {
